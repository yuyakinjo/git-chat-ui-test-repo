#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./clean-up-test-branch

Deletes local branches that match test-branch-*.
If the current branch is one of them, the script switches to main first.
EOF
}

if [[ $# -ne 0 ]]; then
  usage
  exit 1
fi

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

if ! git rev-parse --verify main >/dev/null 2>&1; then
  echo "main branch was not found" >&2
  exit 1
fi

current_branch="$(git branch --show-current)"

if [[ "$current_branch" =~ ^test-branch-[0-9]+$ ]]; then
  git switch main >/dev/null 2>&1
fi

found=0

while IFS= read -r branch; do
  [[ -z "$branch" ]] && continue

  found=1
  git branch -D "$branch" >/dev/null
  echo "Removed $branch"
done < <(git for-each-ref --format='%(refname:short)' refs/heads/test-branch-*)

if [[ "$found" -eq 0 ]]; then
  echo "No local test-branch-* branches found."
  exit 0
fi

echo "Done. Removed local test-branch-* branches."
